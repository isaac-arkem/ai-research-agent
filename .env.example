OPENAI_API_KEY=sk-...
RESEARCH_AGENT_MODEL=gpt-4o

# Supabase — REQUIRED. The agent's country list lives in the
# apify_supported_countries table (sql/002_apify_supported_countries.sql) and
# there is no hardcoded fallback: without a reachable DB the API returns 503
# rather than planning against a stale list. Known handles (reference_accounts)
# are read from here too.
# Uses the same env var names as arkgpt.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SECRET_KEY=sb_secret_...
NEXT_PUBLIC_SUPABASE_PUBLIC_KEY=sb_publishable_...

# Auth: same contract as arkgpt requireSocialListeningUser
# (Authorization: Bearer <supabase access_token>).
# true = /ask and /conversations require a signed-in Supabase user.
# The local :8000 chat page has no login — use arkgpt Planner to try it.
AUTH_REQUIRED=true

# POST /ask rate limit (per user id, or IP when anonymous)
RATE_LIMIT_REQUESTS=20
RATE_LIMIT_WINDOW_SECONDS=60


# ── Web search ──────────────────────────────────────────────────────
# Live lookups the model cannot recall — current hashtags, reference accounts.
#   serper  DEFAULT. Google results. 2,500 free queries, no card required.
#           https://serper.dev  ($1/1k after — cheapest of the three)
#   tavily  returns parsed page content, not just links, but wants a card.
#   brave   $5/1k, also wants a card.
# tavily returns page content, which is what the grounding step reads.


SERPER_API_KEY=
TAVILY_API_KEY=
BRAVE_API_KEY=

SEARCH_TIMEOUT=15
SEARCH_RESULTS_PER_QUERY=5
# Recency: d day, w week, m month, y year
SEARCH_WINDOW=w

# Politeness policy — see app/services/search/policy.py.
# Caching matters most: the same niche+country asked twice in a week is one
# upstream request, which is what keeps you inside the free tier.
SEARCH_CACHE_TTL_SECONDS=604800
SEARCH_MIN_INTERVAL_SECONDS=0.5
SEARCH_JITTER_SECONDS=1.5
SEARCH_MAX_WAIT_SECONDS=5
SEARCH_BREAKER_COOLDOWN_SECONDS=300

# ── Web grounding ─────────────────────────────────────────────
# Search the web before planning so hashtags and creators come from
# this week rather than the model's training data. false restores the
# pre-grounding behaviour exactly.
SEARCH_GROUNDING_ENABLED=true
# Frames the query and decides whether to search at all. Runs on every
# ask, so it should stay small.
GROUNDING_MODEL=gpt-4o-mini
