OPENAI_API_KEY=sk-...
RESEARCH_AGENT_MODEL=gpt-4o

# Supabase — REQUIRED. The agent's country list lives in the
# apify_supported_countries table (sql/002_apify_supported_countries.sql) and
# there is no hardcoded fallback: without a reachable DB the API returns 503
# rather than planning against a stale list. Known handles (reference_accounts)
# are read from here too.
# Uses the same env var names as arkgpt.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SECRET_KEY=sb_secret_...
NEXT_PUBLIC_SUPABASE_PUBLIC_KEY=sb_publishable_...

# Auth: same contract as arkgpt requireSocialListeningUser
# (Authorization: Bearer <supabase access_token>).
# true = /ask and /conversations require a signed-in Supabase user.
# The local :8000 chat page has no login — use arkgpt Planner to try it.
AUTH_REQUIRED=true

# POST /ask rate limit (per user id, or IP when anonymous)
RATE_LIMIT_REQUESTS=20
RATE_LIMIT_WINDOW_SECONDS=60

