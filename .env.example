# ── Required ─────────────────────────────────────────────────────────
# The only value the app refuses to start without.
OPENAI_API_KEY=sk-...


# ── Required in practice ─────────────────────────────────────────────
# The app boots without these, and then cannot do its job. Each one fails
# in its own way, noted below, because a missing key that fails QUIETLY is
# the expensive kind.

# Web search. Every research turn goes through it, so without this a search
# returns nothing and the turn falls back to the planner answering unaided.
# https://www.tavily.com — 1,000 free credits a month.
TAVILY_API_KEY=

# Instagram and TikTok scraping, via the Apify actors. THIS ONE FAILS
# SILENTLY: with no token the social lanes are simply never called, and the
# result looks like "no creators found" rather than "no key configured".
APIFY_TOKEN=

# Supabase. The supported-country list lives in apify_supported_countries
# (sql/002) and there is no hardcoded fallback, so requests return 503
# without a reachable DB. Known handles (reference_accounts) come from here
# too. Same variable names as arkgpt, so one .env serves both.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SECRET_KEY=sb_secret_...
NEXT_PUBLIC_SUPABASE_PUBLIC_KEY=sb_publishable_...


# ── Deployment ───────────────────────────────────────────────────────
# Auth: same contract as arkgpt requireSocialListeningUser
# (Authorization: Bearer <supabase access_token>).
# MUST be true anywhere this service is reachable from outside localhost.
AUTH_REQUIRED=true

# Comma-separated origins. The default below is localhost only — set this
# to your real frontend origin in production or the browser blocks the call.
CORS_ORIGINS=http://localhost:3000,http://localhost:8000

# POST /ask rate limit, per user id, or per IP when anonymous.
RATE_LIMIT_REQUESTS=20
RATE_LIMIT_WINDOW_SECONDS=60

# Mounts /docs, /redoc and /openapi.json. Leave false in production.
DEBUG=false


# ── Models ───────────────────────────────────────────────────────────
# Everything here has a working default. Set a value only to override it.

# Routes every turn: search, ask, plan or skip. Small on purpose — it runs
# on every request, including greetings.
GROUNDING_MODEL=gpt-4o-mini

# Re-asked on the one routing call the small model gets wrong: a skip that
# blames named accounts on a message carrying no "@". Set to empty to turn
# the second call off and take the small model's answer.
GROUNDING_ESCALATION_MODEL=gpt-4o

# Writes the query plan, reranks results, and writes the answer prose.
RESEARCH_PLAN_MODEL=gpt-4o

# Builds the scrape plan once findings are approved.
RESEARCH_AGENT_MODEL=gpt-4o


# ── Research engine ──────────────────────────────────────────────────
# false sends grounding straight to the web provider, exactly as it behaved
# before the multi-source engine existed. An off switch, not a rewrite.
RESEARCH_ENGINE_ENABLED=true

# quick | default | deep. NOT just a result count: "quick" truncates the
# plan to ONE subquery, so it cannot cover two platforms or two regions.
RESEARCH_DEPTH=default

# How far back a run looks. Wide on purpose — a two-year-old "top creators"
# page is often the best evidence there is, and the reranker prefers recent
# items on its own.
RESEARCH_WINDOW_DAYS=365


# ── Web search tuning ────────────────────────────────────────────────
# Search the web before planning, so hashtags and creators come from this
# week rather than the model's training data.
SEARCH_GROUNDING_ENABLED=true

SEARCH_TIMEOUT=15
# Credits are charged per SEARCH, not per result, so asking for fewer buys
# nothing.
SEARCH_RESULTS_PER_QUERY=20
# advanced | basic | fast. advanced returns several snippets per page, which
# is what creator extraction reads: 2 credits a search instead of 1.
SEARCH_DEPTH=advanced
# Recency for the by-hand script only — d, w, m, y, or empty for none. The
# agent does not read this; its window comes from what was asked for.
SEARCH_WINDOW=

# Apify actor for the TikTok lane.
APIFY_TIKTOK_ACTOR=clockworks~tiktok-scraper
