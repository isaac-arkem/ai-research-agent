OPENAI_API_KEY=sk-...
RESEARCH_AGENT_MODEL=gpt-4o

# Supabase — when both are set, markets are fetched from the DB.
# When missing, the agent falls back to the hardcoded list.
# Uses the same env var names as arkgpt.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SECRET_KEY=sb_secret_...
NEXT_PUBLIC_SUPABASE_PUBLIC_KEY=sb_publishable_...

# Auth: same contract as arkgpt requireSocialListeningUser
# (Authorization: Bearer <supabase access_token>). Off for local chat.
AUTH_REQUIRED=false

# POST /ask rate limit (per user id, or IP when anonymous)
RATE_LIMIT_REQUESTS=20
RATE_LIMIT_WINDOW_SECONDS=60

